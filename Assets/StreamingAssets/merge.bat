@echo off
chcp 65001 >nul
setlocal

echo ==========================================
echo  Объединение всех .json файлов в папке
echo ==========================================

:: Проверяем, есть ли json файлы
dir /b *.json >nul 2>&1
if errorlevel 1 (
    echo ОШИБКА: В этой папке нет файлов с расширением .json
    pause
    exit /b
)

:: Объединяем файлы. 
:: /b означает "двоичный режим" (важно для сохранения кодировки и спецсимволов)
echo Объединение...
copy /b *.json merged_result.txt

echo ==========================================
echo  Готово!
echo  Результат сохранен в: merged_result.txt
echo ==========================================
pause